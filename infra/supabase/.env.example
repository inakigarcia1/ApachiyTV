# =============================================================================
# Apachiy TV — Supabase self-hosted env template
# =============================================================================
# Copy to `.env` and regenerate secrets before any production use.
#
# Generate secure secrets:
#   openssl rand -hex 32   # 64 hex chars
#   openssl rand -base64 48
# =============================================================================

# ----- Postgres -----
POSTGRES_DB=postgres
POSTGRES_USER=supabase_admin
# Docker DNS hostname for Postgres inside the compose network (Studio/pg-meta expect `db`).
POSTGRES_HOST=db
POSTGRES_PORT=5432
# REQUIRED. Strong password. Generate with `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# ----- JWT (REQUIRED) -----
# 32+ char secret. Both this Supabase and the Apachiy .NET API read this to sign
# and verify access tokens. Treat as a high-impact secret.
JWT_SECRET=
JWT_EXP=3600

# ----- Public anon + service role keys (REQUIRED) -----
# Generate with the Supabase CLI: `supabase gen keys`. These MUST match the
# JWT_SECRET above. ANON_KEY is what the TV APK embeds; SERVICE_ROLE_KEY stays
# server-side only (storage admin, function admin).
ANON_KEY=
SERVICE_ROLE_KEY=

# ----- Public URLs -----
# Where the API gateway listens on the host network. Used by Kong.
API_EXTERNAL_URL=http://localhost:8000
# Where Studio is reachable from the operator browser.
STUDIO_PUBLIC_URL=http://localhost:3001
# Where the TV app's "site URL" points (used in email links).
SITE_URL=http://localhost:3000
# Extra redirect URLs allowed in GoTrue (comma-separated).
ADDITIONAL_REDIRECT_URLS=http://localhost:3000

# ----- Auth admin (GoTrue) -----
GOTRUE_ADMIN_EMAIL=admin@local
GOTRUE_ADMIN_PASSWORD=

# ----- SMTP (optional) -----
# If left empty, signups auto-confirm and emails go nowhere.
# Configure these for production to enable email verification + password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADMIN=admin@your-apachiy.example
SMTP_SENDER_NAME=Apachiy
ENABLE_AUTOCONFIRM=true

# ----- Realtime -----
SECRET_KEY_BASE=VerYseCRet0000000000000000000000000000000000=

# ----- Analytics / Logflare -----
LOGFLARE_PUBLIC_ACCESS_TOKEN=apachiy-public-token
LOGFLARE_PRIVATE_ACCESS_TOKEN=apachiy-private-token

# ----- Port overrides (defaults already set) -----
APACHIY_SUPABASE_KONG_PORT=8000
APACHIY_SUPABASE_KONG_SSL_PORT=8443
APACHIY_STUDIO_PORT=3001

# ----- Resource limits (optional override) -----
APACHIY_SUPABASE_DB_MEM=1g
APACHIY_SUPABASE_DB_CPUS=1.0
APACHIY_SUPABASE_AUTH_MEM=512m
APACHIY_SUPABASE_AUTH_CPUS=0.5
APACHIY_SUPABASE_STORAGE_MEM=512m
APACHIY_SUPABASE_STORAGE_CPUS=0.5
APACHIY_SUPABASE_STUDIO_MEM=512m
APACHIY_SUPABASE_STUDIO_CPUS=0.5
APACHIY_SUPABASE_FUNCTIONS_MEM=256m
APACHIY_SUPABASE_FUNCTIONS_CPUS=0.25
APACHIY_SUPABASE_IMGPROXY_MEM=256m
APACHIY_SUPABASE_IMGPROXY_CPUS=0.25
APACHIY_SUPABASE_ANALYTICS_MEM=256m
APACHIY_SUPABASE_ANALYTICS_CPUS=0.25
APACHIY_SUPABASE_KONG_MEM=512m
APACHIY_SUPABASE_KONG_CPUS=0.5