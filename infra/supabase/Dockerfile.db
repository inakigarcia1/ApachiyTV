# Postgres 15 with wal2json for Supabase Realtime logical decoding.
# The stock alpine image cannot load the wal2json output plugin Realtime needs.
FROM postgres:15-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-15-wal2json \
    && rm -rf /var/lib/apt/lists/*

COPY volumes/db/init /docker-entrypoint-initdb.d
