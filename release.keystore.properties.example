# =============================================================================
# Apachiy TV — release keystore properties template
# =============================================================================
# Copy to `release.keystore.properties` (gitignored) and fill in your values.
# To create a keystore locally run `./scripts/sign-apachiy-apk.sh`.
# DO NOT commit your real keystore or its passwords.
# =============================================================================

# Path to your apachiy.jks file (absolute or relative to project root).
APACHIY_RELEASE_STORE_FILE=keystore/apachiy.jks

# Key alias inside the keystore.
APACHIY_RELEASE_KEY_ALIAS=apachiy

# Password for the key.
APACHIY_RELEASE_KEY_PASSWORD=

# Password for the keystore itself.
APACHIY_RELEASE_STORE_PASSWORD=